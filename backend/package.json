{
  "name": "rag-doc-chat-backend",
  "version": "1.0.0",
  "description": "REST API for the RAG Document Chat app (Express + TypeScript + LangChain + MongoDB Atlas Vector Search)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create:index": "tsx src/scripts/createVectorIndex.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
