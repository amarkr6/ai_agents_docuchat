# ------------------------------------------------------------
# Backend environment variables
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.
# ------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development
# URL of the React app (used for CORS). Comma-separate multiple URLs.
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers -> copy the connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rag_doc_chat
# Name of the Atlas Vector Search index (created by: npm run create:index)
VECTOR_INDEX_NAME=chunk_vector_index
# Fixes "querySrv ECONNREFUSED" on some networks (uses Google + Cloudflare DNS)
DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Authentication ---
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- AI provider ---
# "gemini" = Google Gemini (free tier, get a key at https://aistudio.google.com/apikey)
# "openai" = OpenAI (paid, key at https://platform.openai.com/api-keys)
AI_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

# Optional overrides — leave empty to use the defaults for the chosen provider:
#   gemini: gemini-flash-latest + gemini-embedding-001 (768 dims), price $0
#   openai: gpt-5-mini + text-embedding-3-small (1536 dims)
# After changing the provider or embedding settings, run: npm run create:index
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Optional cost tracking overrides (USD per 1 million tokens)
PRICE_CHAT_INPUT_PER_1M=
PRICE_CHAT_OUTPUT_PER_1M=
PRICE_EMBEDDING_PER_1M=

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_UPLOAD_MB=10
