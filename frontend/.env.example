# ------------------------------------------------------------
# Frontend environment variables (copy to ".env")
# Only variables starting with VITE_ are visible to the React code.
# ------------------------------------------------------------

# Base URL of the backend API.
#  - Local development: keep "/api" (Vite proxies it to http://localhost:5000)
#  - Production: full URL of your deployed backend, e.g. https://my-api.onrender.com/api
VITE_API_URL=/api
